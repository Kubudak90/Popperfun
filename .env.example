# Copy to apps/web/.env.local. Defaults are official Arc Testnet (docs.arc.io).
# Zero factory = not wired. Do not invent Uniswap V4 or Arc mainnet addresses.
# Anvil: set CHAIN_ID=31337 and RPC_URL=http://127.0.0.1:8545

NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_EXPLORER_TX_URL=https://testnet.arcscan.app/tx/{hash}

# Contracts deploy (never commit the key)
# RPC_URL=https://rpc.testnet.arc.io
# PRIVATE_KEY=
